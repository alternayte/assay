# Assay configuration for Docker Compose. install.sh creates .env from this
# file once and never changes it again.

# Compose settings. Assay does not read them.
ASSAY_VERSION=latest
ASSAY_PORT=8080
POSTGRES_PASSWORD=

# The key that encrypts stored secrets: 32 random bytes in base64.
# Keep a copy. Without it, Assay cannot read stored tokens.
ASSAY_SECRET_KEY=

# The token for the first setup at /setup.
ASSAY_SETUP_TOKEN=

# The public URL of this instance.
ASSAY_BASE_URL=http://localhost:8080

ASSAY_LOG_LEVEL=info

# true starts the Acme fixture server, and setup creates the demo
# connections. install.sh --demo sets it.
ASSAY_DEMO=

# A corporate proxy. db and fixtures must stay in NO_PROXY.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,db,fixtures

# Extra CA certificates in PEM, for a proxy with TLS inspection.
ASSAY_EXTRA_CA_PEM=
