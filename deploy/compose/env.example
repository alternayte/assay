# Assay configuration for Docker Compose. install.sh creates .env from this
# file once. A later run changes only ASSAY_VERSION and ASSAY_DEMO.

# Compose settings. Assay does not read them.
ASSAY_VERSION=latest
ASSAY_PORT=8080
POSTGRES_PASSWORD=

# The key that encrypts stored secrets: 32 random bytes in base64.
# Keep a copy. Without it, Assay cannot read stored tokens.
ASSAY_SECRET_KEY=

# The token for the first setup at /setup.
ASSAY_SETUP_TOKEN=

# The public URL of this instance.
ASSAY_BASE_URL=http://localhost:8080

ASSAY_LOG_LEVEL=info

# Sign-in with the identity provider through OpenID Connect. A set variable
# wins over Settings, Sign-in, and the field there shows as locked. Empty
# means the value in Settings. Register
# <ASSAY_BASE_URL>/api/auth/oauth/sso/callback at the identity provider.
ASSAY_OIDC_ISSUER=
ASSAY_OIDC_CLIENT_ID=
ASSAY_OIDC_CLIENT_SECRET=
ASSAY_OIDC_BUTTON_LABEL=
# The IdP group ID whose members can sign in.
ASSAY_OIDC_ACCESS_GROUP=
# true or false. Password sign-in stays on while SSO is not configured.
ASSAY_PASSWORD_SIGNIN=
# none or entra. entra reads Microsoft Graph with the client ID and the
# client secret above. It needs User.Read.All and GroupMember.Read.All.
ASSAY_DIRECTORY_PROVIDER=
# The directory poll interval: 5 to 1440 minutes. Empty means 15.
ASSAY_DIRECTORY_INTERVAL=

# The job workers of each queue in one worker container. Syncs, extraction
# and design pages run on their own workers, so that the bulk of one never
# holds the others back. Each sync worker runs one part of a sync, such as a
# space or a repository. Empty means 10, 4, 4, 2 and 4.
ASSAY_JOB_WORKERS=
ASSAY_SYNC_WORKERS=
ASSAY_EXTRACT_WORKERS=
ASSAY_DESIGN_WORKERS=
ASSAY_EMBED_WORKERS=

# The embed shards of all worker containers together. Empty means 4.
ASSAY_EMBED_SHARDS=

# true starts the Acme fixture server, and setup creates the demo
# connections. install.sh --demo sets it. install.sh --no-demo removes the
# demo data and sets it to false.
ASSAY_DEMO=

# A corporate proxy. db and fixtures must stay in NO_PROXY.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,db,fixtures

# Extra CA certificates in PEM, for a proxy with TLS inspection.
ASSAY_EXTRA_CA_PEM=
